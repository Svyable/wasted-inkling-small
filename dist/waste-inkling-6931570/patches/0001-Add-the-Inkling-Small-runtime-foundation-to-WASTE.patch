+        fail += waste_inkling_attention_step(&a, one, one, one, one, one,
+                                              zero, zero, 0, 0, 0.0f,
+                                              scores, out) != 0;
+        fail += !closef(out[0], 1.0f);
+    }
+
+    {
+        /* Released Inkling config profile: verifies the generic builder is
