+    @staticmethod
+    def fp(tensor):
+        if tensor.dtype != torch.float32 or not tensor.is_contiguous():
+            raise TypeError("ctypes inputs must be contiguous float32 tensors")
+        return ctypes.cast(tensor.data_ptr(), ctypes.POINTER(ctypes.c_float))
