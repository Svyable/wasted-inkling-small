# Upstream pin for the generated WASTE Inkling integration patch.
#
# This is the only file that changes for a routine upstream rebase. Update the
# commit, re-run verify.sh, and fix whatever overlay fragment failed to apply —
# instead of replaying a 15,000-line patch and narrating the conflicts.

UPSTREAM_REPOSITORY=https://github.com/sqliteai/waste.git
UPSTREAM_COMMIT=69315701f634648f7a790915a0a525ed8aabf218
UPSTREAM_TREE=206a73f61902c41366eaa34f432c8e9b9a5a0675
UPSTREAM_VERSION=0.6.3
UPSTREAM_API_VERSION=1
UPSTREAM_FORMAT_VERSION=0

# Tree hash the generated patch must produce. This is the real invariant: it is
# content-addressed, independent of commit metadata, and it is what CI asserts.
EXPECTED_APPLIED_TREE=ce6c5272e801c651cc6b71f869a1b0cd7167dab5

# Identity used for the generated commit. Deliberately not a person: the commit
# is a build product, and the authorship that matters is this repository's.
PATCH_AUTHOR_NAME="WASTE Inkling integration"
PATCH_AUTHOR_EMAIL=inkling@waste.invalid
PATCH_SUBJECT="Add the Inkling-Small runtime foundation to WASTE"
