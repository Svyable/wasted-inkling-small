+/* The one claim this build has not earned.
+ *
+ * An Inkling container now loads: its geometry is built, its tensors are
+ * bound, and the byte counts the planner reported are the ones the load
+ * produced. None of that is a claim about what a token is. The forward
+ * pass further down is Kimi's, and running an Inkling model through it
+ * would produce output — which is the failure mode worth refusing, because
+ * wrong tokens look exactly like right ones. */
+static int inkling_refuses(const waste_model *m, const char *what)
+{
+    if (!waste_inkling_container_present(m)) return 0;
+    fprintf(stderr,
+            "waste: Inkling container loaded, but %s is not integrated in "
+            "this build\n", what);
+    return 1;
+}
+
+/* The Inkling container reads the same trunk.bin — same offsets, same scale
+ * tables, same packed widths — so it reads it through the same function.
+ * Declared in inkling_container.h, which is who it is for. */
+int waste_trunk_load(waste_model *m, const char *dir, const js_doc *d,
+                     int trunk)
+{
+    return load_trunk(m, dir, d, trunk);
+}
+
+/* One row of any trunk tensor as f32. waste_embed_row is this bound to
+ * Kimi's embedding name and its token clamp; Inkling has two tables under
+ * other names, and a second unpacker for the same bytes is a second thing
+ * to get wrong. Out-of-range rows are refused rather than clamped: the
+ * caller here is a bound weight table, not a user-supplied token. */
+int waste_trunk_row_f32(waste_model *m, const waste_tensor *t, long row,
+                        int cols, float *dst)
+{
+    if (!m || !t || !dst || cols < 1 || row < 0 || t->ndim < 2) return -1;
+    if (t->shape[t->ndim - 1] != cols) return -1;
+    if ((size_t)row >= t->n / (size_t)cols) return -1;
+    if (!t->on_disk) {
+        if (!t->data && !t->q) return -1;
+        waste_deq_row(t, row, cols, dst);
+        return 0;
+    }
+    if (!t->group || !m->embrow || !m->embsc) return -1;
+    {   /* trunk_row lands the row in the model's scratch; deq_row unpacks
+         * whatever width it is at. Reading it as a one-row tensor keeps
+         * the unpacking in one place rather than repeating the bit
+         * arithmetic for a third time. */
+        const int8_t *q; const uint16_t *sc;
+        waste_tensor one = *t;
+        trunk_row(m, t, row, &q, &sc);
+        one.data = NULL;
+        one.q = (int8_t *)q;
+        one.qs = (uint16_t *)sc;
+        one.on_disk = 0;
+        waste_deq_row(&one, 0, cols, dst);
+    }
+    return 0;
+}
