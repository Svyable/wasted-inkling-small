+/* An Inkling container opens — the plan is real, the tensors are bound, and
+ * `info` describes what is actually held. It does not run: the forward pass
+ * is Kimi's, and a promotion that let it produce tokens from these weights
+ * would be a claim no measurement in this repository supports yet. The
+ * model layer refuses too; this is the same refusal with the status code
+ * the caller can act on, and a detail line saying which half is missing. */
+static int inkling_unsupported(waste_ctx *c)
+{
+    if (!waste_inkling_container_present(&c->m)) return 0;
+    snprintf(c->detail, sizeof c->detail,
+             "Inkling container loaded; the public forward path is not "
+             "integrated in this build");
+    return 1;
+}
