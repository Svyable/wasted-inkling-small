 # ---------------------------------------------------------------- unit ----
 head_ "kernels vs the reference implementations"
 
@@ -790,6 +804,121 @@ PYFV
         no "format_version not enforced (rc=$rc rc2=$rc2)"
     fi
 
+    # Inkling dimensions overlap enough with Kimi's to yield plausible but
+    # invalid plans. A Kimi container merely relabelled `Inkling` must be
+    # refused by all three paths rather than planned as either architecture.
+    IA=$(mktemp -d)
+    python3 - "$MODEL/manifest.json" "$IA/manifest.json" <<'PYIA'
+import json, sys
+m = json.load(open(sys.argv[1])); m["arch"] = "Inkling-Small"
+json.dump(m, open(sys.argv[2], "w"))
+PYIA
+    plan_out=$(./waste plan "$IA" 2>&1); plan_rc=$?
+    info_out=$(./waste info "$IA" 2>&1); info_rc=$?
+    load_out=$(./test_forward "$IA" 3 "$TMP/inkling.bin" 0 2>&1); load_rc=$?
+    rm -rf "$IA"
+    # The property under test is that no plausible plan comes out: the
+    # Inkling planner rejects a config that is not Inkling rather than
+    # defaulting its way to a number, so `plan` prints no FLOOR line.
+    if [ "$plan_rc" -ne 0 ] && [ "$info_rc" -ne 0 ] && [ "$load_rc" -ne 0 ] &&
+       ! printf '%s' "$plan_out" | grep -q "FLOOR" &&
+       printf '%s' "$load_out" | grep -q "Inkling container: config"; then
+        ok "a Kimi container relabelled Inkling is refused by every path"
+    else
+        no "Inkling seam on a mislabelled container (plan=$plan_rc info=$info_rc load=$load_rc)"
+    fi
+
+    # A real Inkling manifest plans, because planning is arithmetic over
+    # declared geometry. It still must not open — not because Inkling is
+    # refused any more, but because this manifest describes a container
+    # whose bytes are not there: three trunk entries for a 42-layer model
+    # and one expert bank for forty sparse layers.
+    IB=$(mktemp -d)
+    python3 - "$IB/manifest.json" <<'PYIB'
+import json, sys
+cfg = json.load(open("tests/data/inkling-small-config.json"))["text_config"]
+rec = 9457664
+json.dump({
+    "format_version": 0, "arch": "inkling", "tensor_prefix": "", "config": cfg,
+    "expert_quant": {"stages": 3, "vec_dim": 8, "entries": 256,
+                     "index_block": 16, "bits_per_weight": 3.0},
+    "trunk": [
+        {"name": "inkling.embed", "fmt": 2, "off": 0,
+         "shape": [201024, 4096], "bytes": 838860800},
+        {"name": "inkling.unembed", "fmt": 2, "off": 0,
+         "shape": [200058, 4096], "bytes": 838860800},
+        {"name": "inkling.layers.0.attn.wq", "fmt": 3, "off": 0,
+         "shape": [4096, 4096], "bytes": 8388608},
+    ],
+    "layers": [{"file": "experts-L2.bin", "experts": 256,
+                "bytes": rec * 256, "codebook_base": 0}],
+}, open(sys.argv[1], "w"))
+PYIB
+    iplan_out=$(./waste plan "$IB" 2>&1); iplan_rc=$?
+    iload_out=$(./test_forward "$IB" 3 "$TMP/inkling2.bin" 0 2>&1); iload_rc=$?
+    # A config missing one required field must fail rather than default it.
+    python3 - "$IB/manifest.json" "$IB/partial.json" <<'PYIC'
+import json, sys
+m = json.load(open(sys.argv[1])); m["config"].pop("d_rel")
+json.dump(m, open(sys.argv[2], "w"))
+PYIC
+    mv "$IB/manifest.json" "$IB/full.json" && mv "$IB/partial.json" "$IB/manifest.json"
+    ipart_rc=0; ./waste plan "$IB" >/dev/null 2>&1 || ipart_rc=$?
+    rm -rf "$IB"
+    if [ "$iplan_rc" -eq 0 ] && [ "$ipart_rc" -ne 0 ] && [ "$iload_rc" -ne 0 ] &&
+       printf '%s' "$iplan_out" | grep -q "FLOOR" &&
+       printf '%s' "$iload_out" | grep -q "one bank per sparse layer"; then
+        ok "an Inkling container plans, fails closed on a missing field, and refuses an incomplete container"
+    else
+        no "Inkling planning (plan=$iplan_rc partial=$ipart_rc load=$iload_rc)"
+    fi
+
+    # And a complete one loads. Two containers, one seed, two stored widths:
+    # the f32 side is the oracle, the quantized side exercises the path this
+    # promotion added — matrices that are never materialized and vocabulary
+    # tables that stay on disk. Neither may produce a token.
+    IC=$(mktemp -d)
+    ic_rc=0
+    python3 tools/make_inkling_container.py --out "$IC/f32" --trunk-bits 32 \
+        >/dev/null 2>&1 || ic_rc=1
+    python3 tools/make_inkling_container.py --out "$IC/q8" --trunk-bits 8 \
+        >/dev/null 2>&1 || ic_rc=1
+    python3 tools/make_inkling_container.py --out "$IC/q4" --trunk-bits 4 \
+        >/dev/null 2>&1 || ic_rc=1
+    if [ "$ic_rc" -eq 0 ]; then
+        # Tolerances are relative and stated per stored width: eight bits
+        # agrees to a few thousandths, four to a few hundredths, and a
+        # tolerance that covered both would stop distinguishing rounding
+        # from reading the wrong row.
+        ic_out=$(./test_inkling_container "$IC/f32" "$IC/q8" 0.02 0.03 2>&1); ic_rc=$?
+        ic4_out=$(./test_inkling_container "$IC/f32" "$IC/q4" 0.15 0.25 2>&1); ic4_rc=$?
+        # WASTE_Q8=0 dequantizes the trunk at load, so the same container
+        # binds every matrix resident and the backend is never consulted.
+        # Same answers either way, or one of the two paths is wrong.
+        icq8_out=$(WASTE_Q8=0 ./test_inkling_container "$IC/f32" "$IC/q8" 0.02 0.03 2>&1)
+        icq8_rc=$?
+        icinfo=$(./waste info "$IC/q8" 2>&1); icinfo_rc=$?
+        # A tensor removed from the manifest must fail the binding by name
+        # rather than bind a model with a hole in it.
+        python3 - "$IC/q8/manifest.json" <<'PYID'
+import json, sys
+m = json.load(open(sys.argv[1]))
+m["trunk"] = [t for t in m["trunk"] if t["name"] != "inkling.layer.0.k_sconv"]
+json.dump(m, open(sys.argv[1], "w"))
+PYID
+        icmiss_rc=0; ./waste info "$IC/q8" >/dev/null 2>&1 || icmiss_rc=$?
+    else
+        ic4_rc=1; icq8_rc=1; icinfo_rc=1; icmiss_rc=0; ic_out="generator failed"
+    fi
+    rm -rf "$IC"
+    if [ "$ic_rc" -eq 0 ] && [ "$ic4_rc" -eq 0 ] && [ "$icq8_rc" -eq 0 ] &&
+       [ "$icinfo_rc" -eq 0 ] && [ "$icmiss_rc" -ne 0 ] &&
+       printf '%s' "$icinfo" | grep -q "inkling"; then
+        ok "an Inkling container loads, binds, plans to the byte, and refuses to step"
+    else
+        no "Inkling load (q8=$ic_rc q4=$ic4_rc deq=$icq8_rc info=$icinfo_rc missing=$icmiss_rc) $ic_out"
+    fi
+
     if [ -n "${WASTE_SANITIZED:-}" ]; then
         sk "peak RSS inside the budget" "sanitizer shadow memory makes RSS meaningless"
     elif [ "$SYNTHETIC" = 1 ]; then
