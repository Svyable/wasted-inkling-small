- * Usage: ./diskbench /Volumes/WasteDisk/k3/.bench [file_gb] [rec_mb] [threads]
+ * Usage: ./diskbench PATH [file_gb] [rec_mb] [threads] [gb_per_token]
+ *
+ * `gb_per_token` scales the trailing tok/s column to the model under test:
+ * K3 reads ~12.5 GB per cold token, Inkling-Small ~2.11 GiB (240 records of
+ * 9,457,664 B). It defaults to K3's, which is what this file was written for.
+ *
+ * On Linux the reads are opened O_DIRECT. Until 2026-08-08 `nocache()` was
+ * `#ifdef __APPLE__` with no Linux arm and no open flag, so every Linux run
+ * of this benchmark measured the page cache whenever the file fit in RAM —
+ * which is the exact fiction docs/GATES.md Gate 5 exists to prevent, and it
+ * reported it as the number that sets tok/s. If O_DIRECT is refused (tmpfs,
+ * some overlay and network filesystems) the run says so on stderr and in the
+ * result line rather than quietly reporting cached bandwidth.
  */
 #define _GNU_SOURCE
 #include <errno.h>
@@ -32,20 +44,49 @@ static void nocache(int fd) {
 #ifdef __APPLE__
     fcntl(fd, F_NOCACHE, 1);
     fcntl(fd, F_RDAHEAD, 0);
+#else
+    (void)fd;   /* O_DIRECT does this on Linux; see open_read() */
+#endif
+}
+
+/* Open for reading with the page cache out of the way. O_DIRECT is the only
+ * thing on Linux that actually removes it; POSIX_FADV_DONTNEED merely asks,
+ * and asks about pages that are already resident. g_direct records whether we
+ * got it, because a benchmark that silently falls back is worse than one that
+ * fails — it produces a plausible number that is off by the size of RAM. */
+static int g_direct = -1;        /* -1 unknown, 1 O_DIRECT, 0 buffered */
+
+static int open_read(const char *path) {
+    int fd = -1;
+#ifdef O_DIRECT
+    fd = open(path, O_RDONLY | O_DIRECT);
+    if (fd >= 0) {
+        if (g_direct != 0) g_direct = 1;
+        nocache(fd);
+        return fd;
+    }
+#endif
+    fd = open(path, O_RDONLY);
+    if (fd < 0) return fd;
+    g_direct = 0;
+    nocache(fd);
+#if defined(POSIX_FADV_DONTNEED)
+    posix_fadvise(fd, 0, 0, POSIX_FADV_DONTNEED);
 #endif
+    return fd;
 }
 
 static const char *g_path;
 static size_t g_rec, g_file;
 static int g_reps;
+static double g_gb_per_token = 12.5;   /* K3 cold token; see usage above */
 
 typedef struct { int id, nthreads; double bytes; } targ;
 
 static void *rand_reader(void *p) {
     targ *a = (targ *)p;
-    int fd = open(g_path, O_RDONLY);
