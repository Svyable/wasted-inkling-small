+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 SQLite Cloud, Inc.
+"""Inkling-family conversion entry point.
+
+Patch 2 intentionally implements only the source audit and deterministic
+conversion plan.  It will not create a directory that looks like a usable
+WASTE container until payload conversion and the C runtime are implemented and
+validated.  This preserves atomic publication and prevents a plan-only run from
+leaving a misleading manifest.json behind.
+"""
+
+from __future__ import annotations
+
+import argparse
+import sys
+from pathlib import Path
+
+from inspect_inkling import InspectError
+from inkling_plan import PlanError, build_plan, write_json_atomic
+
+
+def main(argv: list[str] | None = None) -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--src", required=True, type=Path, help="official Inkling checkpoint directory")
+    ap.add_argument("--out", required=True, type=Path, help="future WASTE output directory")
+    ap.add_argument(
+        "--plan-only",
+        action="store_true",
+        help="validate metadata/shapes and write conversion-plan.json only",
+    )
+    ap.add_argument(
+        "--allow-index-only",
+        action="store_true",
+        help="allow a review plan when shards are not downloaded; never valid for conversion",
+    )
+    args = ap.parse_args(argv)
+
+    if not args.plan_only:
+        print(
+            "convert_inkling: payload conversion is not implemented in this patch; "
+            "refusing to create a partial or misleading WASTE container. "
+            "Run with --plan-only to validate the official source checkpoint.",
+            file=sys.stderr,
+        )
+        return 2
+
+    try:
+        plan = build_plan(args.src, require_payloads=not args.allow_index_only)
+    except (InspectError, PlanError) as exc:
+        print(f"convert_inkling: {exc}", file=sys.stderr)
+        return 2
+
+    # A plan is a side artifact, not a container commit record.  In particular,
+    # do not create manifest.json, trunk.bin, banks, or codebooks.bin here.
+    path = args.out / "conversion-plan.json"
+    write_json_atomic(path, plan)
+    print(f"wrote {path}")
+    print("no WASTE container files were created")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
