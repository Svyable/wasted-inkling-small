diff --git a/src/inkling_stage_reader.c b/src/inkling_stage_reader.c
new file mode 100644
index 0000000..46cb6e0
--- /dev/null
+++ b/src/inkling_stage_reader.c
@@ -0,0 +1,72 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#define _POSIX_C_SOURCE 200809L
+#include "inkling_stage_reader.h"
+#include <fcntl.h>
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#define IKTN_MAGIC 0x4e544b49u
+#define IKBF_MAGIC 0x46424b49u
+
+static uint32_t crc32u(const unsigned char *p, size_t n)
+{
+    uint32_t c=~0u;
+    for(size_t i=0;i<n;i++){ c^=p[i]; for(int k=0;k<8;k++) c=(c>>1)^((0u-(c&1u))&0xedb88320u); }
+    return ~c;
+}
+static uint32_t rd32(const unsigned char *p){return (uint32_t)p[0]|((uint32_t)p[1]<<8)|((uint32_t)p[2]<<16)|((uint32_t)p[3]<<24);}
+static uint64_t rd64(const unsigned char *p){return (uint64_t)rd32(p)|((uint64_t)rd32(p+4)<<32);}
+static uint16_t rd16(const unsigned char *p){return (uint16_t)(p[0]|(p[1]<<8));}
+static float bf16(uint16_t x){ union{uint32_t u;float f;}v={(uint32_t)x<<16}; return v.f; }
+static float f16(uint16_t h){
+    unsigned s=h>>15,e=(h>>10)&31,m=h&1023; union{uint32_t u;float f;}v;
+    if(!e){ if(!m) v.u=s<<31; else {e=1;while(!(m&1024)){m<<=1;e--;}m&=1023;v.u=(s<<31)|((e+112)<<23)|(m<<13);} }
+    else if (e == 31) v.u = (s << 31) | 0x7f800000u | (m << 13);
+    else v.u = (s << 31) | ((e + 112) << 23) | (m << 13);
+    return v.f;
+}
+static int preadn(int fd,void *buf,size_t n,uint64_t off){unsigned char*p=buf;while(n){ssize_t r=pread(fd,p,n,(off_t)off);if(r<=0)return -1;p+=r;n-=r;off+=(uint64_t)r;}return 0;}
+
+int waste_inkling_stage_tensor_open(waste_inkling_stage_tensor *t,const char *path,const char *name,const int *shape,int ndim,int verify)
+{
+    if (!t || !path || !name || !shape || ndim < 1 || ndim > 4) return -1;
+    memset(t, 0, sizeof *t);
+    t->fd = -1;
+    int fd=open(path,O_RDONLY); if(fd<0)return -1; unsigned char h[64]; if(preadn(fd,h,64,0)){close(fd);return -1;}
+    if(rd32(h)!=IKTN_MAGIC||rd16(h+4)!=1||h[7]!=(unsigned)ndim){close(fd);return -1;}
+    int dtype=h[6]; size_t elem=dtype==3?4:2; uint64_t elems=1;
+    for(int i=0;i<ndim;i++){uint32_t d=rd32(h+12+4*i);if(d!=(uint32_t)shape[i]||!d){close(fd);return -1;}if(elems>UINT64_MAX/d){close(fd);return -1;}elems*=d;}
+    uint64_t bytes=rd64(h+28); if(bytes!=elems*elem){close(fd);return -1;}
+    uint32_t nc=crc32u((const unsigned char*)name,strlen(name)); if(rd32(h+40)!=nc){close(fd);return -1;}
+    if(verify){unsigned char *p=malloc((size_t)bytes);if(!p||preadn(fd,p,(size_t)bytes,64)||crc32u(p,(size_t)bytes)!=rd32(h+36)){free(p);close(fd);return -1;}free(p);}
+    t->fd=fd;t->payload_off=64;t->payload_bytes=bytes;t->rows=(uint32_t)shape[0];t->cols=ndim==1?1u:(uint32_t)shape[1];t->dtype=dtype;return 0;
+}
+int waste_inkling_stage_tensor_row(void *ctx,int row,int cols,float*out)
+{
+    waste_inkling_stage_tensor*t=ctx;if(!t||t->fd<0||!out||row<0||row>=(int)t->rows||cols!=(int)t->cols)return -1;
+    size_t elem=t->dtype==3?4:2,n=(size_t)cols*elem;unsigned char*p=malloc(n);if(!p)return -1;
+    if(preadn(t->fd,p,n,t->payload_off+(uint64_t)row*n)){free(p);return -1;}
+    if(t->dtype==3)memcpy(out,p,n);else for(int i=0;i<cols;i++){uint16_t x=rd16(p+2*i);out[i]=t->dtype==1?bf16(x):f16(x);}free(p);return 0;
+}
+void waste_inkling_stage_tensor_close(waste_inkling_stage_tensor*t){if(t&&t->fd>=0)close(t->fd);if(t)memset(t,0,sizeof *t);}
+
+int waste_inkling_stage_bank_open(waste_inkling_stage_bank*b,const char*path,int layer,int experts,int hidden,int inter,uint64_t rec,int verify)
+{
+    if (!b || !path || layer < 0 || experts < 1 || hidden < 1 || inter < 1 || rec < 64) return -1;
+    memset(b, 0, sizeof *b);
+    b->fd = open(path, O_RDONLY);
+    if (b->fd < 0) return -1;
+    b->layer=layer;b->experts=experts;b->hidden=hidden;b->intermediate=inter;b->record_bytes=rec;b->verify_crc=verify;
+    size_t g=(size_t)hidden*inter;b->gate=malloc(g*sizeof(float));b->up=malloc(g*sizeof(float));b->down=malloc(g*sizeof(float));if(!b->gate||!b->up||!b->down){waste_inkling_stage_bank_close(b);return -1;}return 0;
+}
+int waste_inkling_stage_expert_get(void*ctx,int layer,int expert,waste_inkling_expert_weights*out)
+{
+    waste_inkling_stage_bank*b=ctx;if(!b||!out||b->fd<0||layer!=b->layer||expert<0||expert>=b->experts)return -1;unsigned char h[64];uint64_t base=(uint64_t)expert*b->record_bytes;
+    if(preadn(b->fd,h,64,base)||rd32(h)!=IKBF_MAGIC||rd16(h+4)!=1||rd16(h+6)!=(uint16_t)layer||rd16(h+8)!=(uint16_t)expert||h[10]!=1||rd32(h+12)!=(uint32_t)b->hidden||rd32(h+16)!=(uint32_t)b->intermediate)return -1;
+    uint64_t go=rd64(h+20),uo=rd64(h+28),doff=rd64(h+36),pb=rd64(h+44);size_t one=(size_t)b->hidden*b->intermediate*2u;if(go!=64||uo!=64+one||doff!=64+2*one||pb!=3*one||64+pb>b->record_bytes)return -1;
+    unsigned char*p=malloc((size_t)pb);if(!p||preadn(b->fd,p,(size_t)pb,base+64)){free(p);return -1;}if(b->verify_crc&&crc32u(p,(size_t)pb)!=rd32(h+52)){free(p);return -1;}
+    size_t n=one/2;for(size_t i=0;i<n;i++){b->gate[i]=bf16(rd16(p+2*i));b->up[i]=bf16(rd16(p+one+2*i));b->down[i]=bf16(rd16(p+2*one+2*i));}free(p);out->gate=b->gate;out->up=b->up;out->down=b->down;return 0;
+}
+void waste_inkling_stage_bank_close(waste_inkling_stage_bank*b){if(!b)return;if(b->fd>=0)close(b->fd);free(b->gate);free(b->up);free(b->down);memset(b,0,sizeof*b);b->fd=-1;}
