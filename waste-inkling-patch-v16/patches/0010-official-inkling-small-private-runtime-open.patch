+                ctypes.byref(cfg), ctypes.byref(direct), ctypes.byref(state),
+                ctypes.byref(scratch), token, pos, a, len(a),
+                null_expert, None), 0)
+            self.assertEqual(self.lib.waste_inkling_private_step(
